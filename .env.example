# ============================================
# Yoai 環境變量範本 — 複製為 .env 後填入真實值
# ============================================

# 資料庫 — Vercel 部署時用 Vercel Postgres 連接字符串
# 本地開發可選: Neon 免費實例 (https://neon.tech) 或本地 Postgres
# 範例: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth 認證 — 隨意一個長字串即可
AUTH_SECRET="請用 openssl rand -base64 32 生成一個"

# NextAuth URL — Vercel 部署後改為你的真實域名
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# 阿里雲通義千問 / 百煉 (DashScope) API Key
# 申請: https://bailian.console.aliyun.com/apiKey
# 新格式: sk-ws-{id}.{secret}.{signature}
DASHSCOPE_API_KEY="sk-ws-xxxxxxxxxx.xxxxxx.xxxxxx"

# (可選) 個性化 API Host — 從百煉控制台 API-Key 詳情頁「OpenAI 兼容地址」拷貝
# 不填的話用通用地址 (https://dashscope.aliyuncs.com/compatible-mode/v1)
DASHSCOPE_BASE_URL="https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# 對話模型 — 推薦 qwen-plus (平衡) / qwen-max (最強) / qwen-turbo (便宜)
DASHSCOPE_CHAT_MODEL="qwen-plus"

# 視覺模型 — 推薦 qwen-vl-plus
DASHSCOPE_VL_MODEL="qwen-vl-plus"

# (可選) 預設家庭群組名稱 — 第一次登入時自動建立
DEFAULT_FAMILY_NAME="我們的家"
