// Yoai 數據模型
// 設計原則: 個人數據(userId 級別)與家庭共享數據(familyGroupId 級別)嚴格分離

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Vercel + Neon 整合:Prisma 用 UNPOOLED 連接(無 pgbouncer),避開 prepared statement 問題
  // 部署到 Vercel 時,Vercel 會自動注入 DATABASE_URL (pgbouncer) 和 DATABASE_URL_UNPOOLED (direct)
  // 我們用 UNPOOLED 那個,Prisma 連線最穩
  provider = "postgresql"
  url      = env("DATABASE_URL_UNPOOLED")
}

// ========= 用戶 =========
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?        // 可選 — 也支持 OAuth / Email Magic Link
  avatarUrl     String?
  shareSource   String?        // 從哪個分享連結進來的(追蹤用)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 一個用戶屬於一個家庭群組
  familyGroupId String?
  familyGroup   FamilyGroup?   @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)

  // 一個用戶在家庭中的角色
  familyRole    String         @default("member") // "owner" | "member"

  // 關聯 — 只查詢 userId = 自己 的數據
  conversations  Conversation[]
  memories       Memory[]
  uploadedFoods  FoodRecord[]   @relation("FoodUploader")
  usageLogs      UsageLog[]
  feedbacks      Feedback[]
  sessions       Session[]

  @@index([familyGroupId])
  @@index([createdAt])
}

// ========= 家庭群組 =========
model FamilyGroup {
  id        String   @id @default(cuid())
  name      String
  // 邀請碼 — 新成員可透過此碼加入
  inviteCode String  @unique @default(cuid())
  createdAt DateTime @default(now())

  members   User[]
  foods     FoodRecord[] // 食物記錄對所有成員可見
}

// ========= 食物記錄(家庭共享) =========
model FoodRecord {
  id            String       @id @default(cuid())
  familyGroupId String
  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User         @relation("FoodUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // 從圖片提取的結構化資料
  name          String       // 品名,如 "雞蛋 6 入"
  category      String?      // "蔬菜" | "水果" | "肉類" | "乳製品" | "零食" | "其他"
  quantity      Float        @default(1)
  unit          String?      // "個" | "盒" | "包" | "kg" | "g" | "ml" | "L"
  expiryDate    DateTime?    // 有效日期(可選)
  imageUrl      String?      // 原圖 URL
  sourceText    String?      // 用戶輸入的原始文字
  rawVisionJson String?      // 視覺模型原始回傳(JSON 字符串)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([familyGroupId, createdAt])
  @@index([uploadedById])
}

// ========= 對話記錄(個人私密) =========
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  // 附加資料 — 例如用戶情緒標籤、是否包含圖片
  metadata  String?  // JSON 字符串
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ========= 個人記憶(個人私密) =========
model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // key: 偏好鍵 , value: 內容
  key       String   // "favorite_food" | "allergy" | "lifestyle" | ...
  value     String
  // 強度 — 隨時間衰減
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ========= 使用量日誌(用於 Rate Limiting + 統計) =========
model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 調用類型
  type            String   // "chat" | "vision" | "food"
  // 估算的 token 消耗
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  // 自動分類(用於 dashboard 趨勢分析)
  category        String?  // "diet" | "emotion" | "recipe" | "info" | "other"
  // 請求摘要(不保存原文,只保存前 100 字)
  requestSummary  String?
  responseSummary String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
}

// ========= 用戶反饋 =========
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 反饋類型: "thumbs" (按讚/倒讚) | "text" (文字反饋)
  type      String
  // thumbs 類型: 1 = 讚, -1 = 倒讚
  // text 類型: 0 (不評分)
  rating    Int      @default(0)
  // 對應的 assistant 訊息 ID(可選)
  messageContent String?
  // 文字反饋內容
  content   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ========= NextAuth Session =========
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}
