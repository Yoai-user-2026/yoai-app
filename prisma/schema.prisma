// Yoai 數據模型
// 設計原則: 個人數據(userId 級別)與家庭共享數據(familyGroupId 級別)嚴格分離

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Vercel + Neon 整合:Prisma 用 UNPOOLED 連接(無 pgbouncer),避開 prepared statement 問題
  // 部署到 Vercel 時,Vercel 會自動注入 DATABASE_URL (pgbouncer) 和 DATABASE_URL_UNPOOLED (direct)
  // 我們用 UNPOOLED 那個,Prisma 連線最穩
  provider = "postgresql"
  url      = env("DATABASE_URL_UNPOOLED")
}

// ========= 用戶 =========
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?        // 可選 — 也支持 OAuth / Email Magic Link
  avatarUrl     String?
  shareSource   String?        // 從哪個分享連結進來的(追蹤用)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 一個用戶屬於一個家庭群組
  familyGroupId String?
  familyGroup   FamilyGroup?   @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)

  // 一個用戶在家庭中的角色
  familyRole    String         @default("member") // "owner" | "member"

  // 關聯 — 只查詢 userId = 自己 的數據
  conversations  Conversation[]
  memories       Memory[]
  uploadedFoods  FoodRecord[]   @relation("FoodUploader")
  usageLogs      UsageLog[]
  feedbacks      Feedback[]
  sessions       Session[]

  // 健康資料 — 完全個人化,跟家庭隔離
  healthConsent              HealthConsent?
  healthRecords              HealthRecord[]
  healthCustomIndicators     HealthCustomIndicator[]
  healthFiles                HealthFile[]

  @@index([familyGroupId])
  @@index([createdAt])
}

// ========= 家庭群組 =========
model FamilyGroup {
  id        String   @id @default(cuid())
  name      String
  // 邀請碼 — 新成員可透過此碼加入
  inviteCode String  @unique @default(cuid())
  // 內測帳號 — isInternal=true 的家庭不受 rate limit 限制
  // 設給產品負責人/內測夥伴,讓他們自由測試
  isInternal Boolean  @default(false)
  createdAt DateTime @default(now())

  members   User[]
  foods     FoodRecord[] // 食物記錄對所有成員可見
}

// ========= 食物記錄(家庭共享) =========
model FoodRecord {
  id            String       @id @default(cuid())
  familyGroupId String
  familyGroup   FamilyGroup  @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  uploadedById  String
  uploadedBy    User         @relation("FoodUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // 從圖片提取的結構化資料
  name          String       // 品名,如 "雞蛋 6 入"
  category      String?      // "蔬菜" | "水果" | "肉類" | "乳製品" | "零食" | "其他"
  quantity      Float        @default(1)
  unit          String?      // "個" | "盒" | "包" | "kg" | "g" | "ml" | "L"
  expiryDate    DateTime?    // 有效日期(可選)
  imageUrl      String?      // 原圖 URL
  sourceText    String?      // 用戶輸入的原始文字
  rawVisionJson String?      // 視覺模型原始回傳(JSON 字符串)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([familyGroupId, createdAt])
  @@index([uploadedById])
}

// ========= 對話記錄(個人私密) =========
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  // 附加資料 — 例如用戶情緒標籤、是否包含圖片
  metadata  String?  // JSON 字符串
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ========= 個人記憶(個人私密) =========
model Memory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // key: 偏好鍵 , value: 內容
  key       String   // "favorite_food" | "allergy" | "lifestyle" | ...
  value     String
  // 強度 — 隨時間衰減
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ========= 使用量日誌(用於 Rate Limiting + 統計) =========
model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 調用類型
  type            String   // "chat" | "vision" | "food"
  // 估算的 token 消耗
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  // 自動分類(用於 dashboard 趨勢分析)
  category        String?  // "diet" | "emotion" | "recipe" | "info" | "other"
  // 請求摘要(不保存原文,只保存前 100 字)
  requestSummary  String?
  responseSummary String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([type, createdAt])
}

// ========= 用戶反饋 =========
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 反饋類型: "thumbs" (按讚/倒讚) | "text" (文字反饋)
  type      String
  // thumbs 類型: 1 = 讚, -1 = 倒讚
  // text 類型: 0 (不評分)
  rating    Int      @default(0)
  // 對應的 assistant 訊息 ID(可選)
  messageContent String?
  // 文字反饋內容
  content   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ========= NextAuth Session =========
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

// ========= 健康資料:同意書 (GDPR-style) =========
model HealthConsent {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentVersion  String   // 同意書版本,未來更新條款可追蹤
  consentedAt     DateTime @default(now())
  // 用戶記錄 — 用於 audit log
  ipAddress       String?
  userAgent       String?
}

// ========= 健康資料:體檢記錄 (加密存儲) =========
model HealthRecord {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 加密 9 個常規指標 (JSON: { cholesterol, ldl, hdl, ... })
  encryptedData String   // base64 ciphertext
  iv            String   // base64 IV
  authTag       String   // GCM auth tag

  // 明文 metadata
  recordDate    DateTime // 體檢日期
  note          String?  // 備註 ("公司年度體檢")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, recordDate])
}

// ========= 健康資料:自訂指標 =========
// 一個 name 對應多個 entry (時間序列)
model HealthCustomIndicator {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Name 不加密 (只是 label,例如 "月經週期", "血壓收縮壓")
  name          String
  unit          String?  // "天" | "mmHg" | "kg"
  referenceMin  Float?   // 正常下限
  referenceMax  Float?   // 正常上限

  entries       HealthCustomIndicatorEntry[]

  createdAt     DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model HealthCustomIndicatorEntry {
  id          String   @id @default(cuid())
  indicatorId String
  indicator   HealthCustomIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  // 值 — 加密 (用 user-specific key)
  encryptedValue String
  iv             String
  authTag        String
  // 對 value 為文字型的支援 (例如 "正常 / 偏高")
  isText         Boolean  @default(false)
  // 明文 metadata
  recordDate     DateTime
  note           String?

  createdAt      DateTime @default(now())

  @@index([indicatorId, recordDate])
}

// ========= 健康資料:上傳文件 (病歷/醫生紙/體檢報告) =========
model HealthFile {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Vercel Blob
  blobUrl       String   // 公開 URL (Vercel Blob 預設 unguessable)
  blobPathname  String   // 用於刪除

  // 文件 metadata (不加密)
  filename      String
  fileType      String   // "pdf" | "image"
  fileSize      Int      // bytes

  // 病歷 metadata
  documentType  String?  // "病歷" | "醫生紙" | "體檢報告" | "其他"
  note          String?

  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ========= 動態學習的食物知識 =========
// 當用戶拍照加入新食物但不在靜態知識庫時,系統自動 call LLM 抽取結構化知識存這
// 靜態 KB 優先 → LearnedFood 補充
model LearnedFood {
  id            String   @id @default(cuid())

  name          String   @unique  // 標準名稱
  aliases       String[] // 其他常見叫法
  category      String   // 蔬菜/水果/肉類/...

  // 結構化知識 (跟靜態 KB 一致,方便 merge)
  safetyNotes   Json     // [{ type, text, sources, confidence }]
  petDanger     Json?    // { dog, cat, source, note }
  commonAllergens String[]
  healthBenefits Json     // [{ text, source }]
  purchaseAdvice String?

  // 來源 — 哪個用戶教給 Yoai 的
  sourceUserId  String?
  source        String   // "user_taught" | "admin_added"

  // 信心度 — low 表示 LLM 也不太確定,未來可人工 review
  confidence    String   @default("medium") // "low" | "medium" | "high"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([category])
}
